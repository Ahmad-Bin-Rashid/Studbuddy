<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSidebar"
    android:elevation="8dp"
    android:orientation="vertical">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryDark"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:paddingStart="@dimen/spacing_large"
        android:paddingEnd="@dimen/spacing_large"
        android:paddingBottom="@dimen/spacing_large">

        <ImageButton
            android:id="@+id/imageButtonCloseSidebar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:background="@android:color/transparent"
            android:contentDescription="@string/btn_close_menu"
            android:src="@drawable/ic_close"
            android:tint="@color/colorTextOnPrimary" />

        <TextView
            android:id="@+id/textViewSidebarAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/app_name"
            android:textColor="@color/colorTextOnPrimary"
            android:textSize="@dimen/text_size_headline"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewSidebarTagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:text="Your Academic Companion"
            android:textColor="@color/colorSidebarItem"
            android:textSize="@dimen/text_size_small" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.3"
        android:background="@color/colorDivider" />

    <!-- Navigation Items -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_small">

            <include
                android:id="@+id/navItemTimetable"
                layout="@layout/item_sidebar_nav" />

            <include
                android:id="@+id/navItemAssignments"
                layout="@layout/item_sidebar_nav" />

            <include
                android:id="@+id/navItemAttendance"
                layout="@layout/item_sidebar_nav" />

            <include
                android:id="@+id/navItemExams"
                layout="@layout/item_sidebar_nav" />

            <include
                android:id="@+id/navItemGpa"
                layout="@layout/item_sidebar_nav" />

            <include
                android:id="@+id/navItemSettings"
                layout="@layout/item_sidebar_nav" />

        </LinearLayout>
    </ScrollView>

    <!-- Footer -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.5"
        android:gravity="center"
        android:padding="@dimen/spacing_medium"
        android:text="StudBuddy v1.0"
        android:textColor="@color/colorSidebarItem"
        android:textSize="@dimen/text_size_caption" />

</LinearLayout>