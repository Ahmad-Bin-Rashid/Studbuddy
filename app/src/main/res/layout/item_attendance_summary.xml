<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardAttendanceSummaryItem"
    style="@style/Style.StudBuddy.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <!-- Row 1: course + percentage -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textViewSummaryCourseName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                tools:text="Computer Science 101" />

            <TextView
                android:id="@+id/textViewSummaryPercentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="85%"
                tools:textColor="@color/colorStatusNormal" />
        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBarAttendance"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:max="100"
            tools:progress="85" />

        <!-- Row 3: counts + threshold indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textViewSummaryPresent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorStatusNormal"
                android:textSize="@dimen/text_size_small"
                tools:text="✓ 10 Present" />

            <View
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@color/colorDivider" />

            <TextView
                android:id="@+id/textViewSummaryAbsent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorStatusCritical"
                android:textSize="@dimen/text_size_small"
                tools:text="✗ 2 Absent" />

            <View
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@color/colorDivider" />

            <TextView
                android:id="@+id/textViewSummaryLate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorStatusWarning"
                android:textSize="@dimen/text_size_small"
                tools:text="~ 1 Late" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/textViewThresholdStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_caption"
                tools:text="✓ Safe"
                tools:textColor="@color/colorStatusNormal" />
        </LinearLayout>

        <!-- Red card overlay for critical attendance (<60%) -->
        <View
            android:id="@+id/viewCriticalOverlay"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:background="@color/colorStatusCritical"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>
</androidx.cardview.widget.CardView>