<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudBuddy">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".timetable.TimetableActivity"
            android:label="@string/timetable_screen_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".assignments.AssignmentsActivity"
            android:label="@string/assignments_screen_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".exams.ExamsActivity"
            android:label="@string/exams_screen_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".attendance.AttendanceActivity"
            android:label="@string/attendance_screen_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".gpa.CourseActivity"
            android:label="@string/course_screen_title"
            android:parentActivityName=".MainActivity" />

    </application>

</manifest>